{
  "name": "calynda-syntax",
  "displayName": "Calynda Syntax",
  "description": "Syntax highlighting and language configuration for the current Calynda 1.0.0-alpha.8 surface.",
  "version": "1.0.0-alpha.8",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codewriter3000/calynda-lang.git",
    "directory": "vscode-calynda"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "files": [
    "language-configuration.json",
    "syntaxes/**",
    "README.md",
    "LICENSE"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "calynda",
    "syntax",
    "highlighting",
    "language",
    "union",
    "manual-memory",
    "heterogeneous-arrays",
    "layout",
    "threading",
    "typed-pointers",
    "template-literals"
  ],
  "contributes": {
    "languages": [
      {
        "id": "calynda",
        "aliases": [
          "Calynda",
          "calynda"
        ],
        "extensions": [
          ".cal"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "calynda",
        "scopeName": "source.calynda",
        "path": "./syntaxes/calynda.tmLanguage.json"
      }
    ]
  }
}